# Copie este arquivo para ".env" e preencha com os dados do seu app Web no Firebase
# (Configurações do projeto > Seus apps > app Web > firebaseConfig).
# Enquanto estiver vazio, o Pataporte roda no MODO DE TESTE (dados só no celular).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# IA (Google Gemini) — lê a foto do pet e responde no Guia de bordo.
# Crie a chave grátis em https://aistudio.google.com/apikey
# (TESTE: a chave vai junto no app. Antes de publicar, mover para um servidor.)
EXPO_PUBLIC_GEMINI_API_KEY=
# opcional: força um modelo específico (o app tenta gemini-flash-latest, depois gemini-2.5-flash)
EXPO_PUBLIC_GEMINI_MODEL=
