{
  "expo": {
    "name": "Pataporte",
    "slug": "pataporte",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pataporte.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.pataporte.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D4A52",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F6EEDC"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Pataporte usa suas fotos para o diário de vida, a foto do passaporte e para a IA reconhecer a raça do pet.",
          "cameraPermission": "O Pataporte usa a câmera para fotografar seu pet (foto do passaporte e diário de vida)."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1D4A52"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Pataporte usa o microfone para você mandar perguntas por voz ao Guia IA."
        }
      ],
      "expo-asset",
      "expo-apple-authentication"
    ],
    "scheme": "pataporte",
    "backgroundColor": "#F6EEDC",
    "experiments": {
      "typedRoutes": false
    },
    "description": "O passaporte da vida do seu pet: vacinas, rotina, diário e Guia com IA.",
    "owner": "juansanchees",
    "extra": {
      "eas": {
        "projectId": "7ab80f91-bc95-4922-a914-87474bbe7440"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7ab80f91-bc95-4922-a914-87474bbe7440"
    }
  }
}
