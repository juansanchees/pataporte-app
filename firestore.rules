rules_version = '2';
// Regras de segurança do Pataporte.
// Cada tutor só enxerga o próprio perfil e os pets em que está na lista "guardianIds".
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      // Quando a cobrança real (loja/RevenueCat) entrar, trave o plano aqui e mude só pelo servidor:
      //   && (!('plan' in request.resource.data) || request.resource.data.plan == resource.data.plan)
    }

    // contagem de uso da IA: só o servidor grava; a pessoa pode ver e apagar a própria
    match /usage/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // v1.1 · ranking por cidade/raça (temporada = mês "2026-10"). Documento público entre usuários logados,
    // com SÓ nome do pet, espécie, raça, cidade, milhas e nível (nada do tutor). Cada um grava só o próprio
    // documento, cujo id começa pelo uid: "{uid}_{petId}".
    match /ranking/{season}/entries/{entryId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && entryId.matches('^' + request.auth.uid + '_.+$');
      allow create, update: if request.auth != null
        && entryId.matches('^' + request.auth.uid + '_.+$')
        && season.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['petName', 'species', 'breed', 'city', 'cityKey', 'breedKey', 'seasonMiles', 'level', 'season', 'updatedAt'])
        && request.resource.data.keys().hasAll(['petName', 'species', 'breed', 'city', 'cityKey', 'breedKey', 'seasonMiles', 'level', 'season'])
        && request.resource.data.petName is string && request.resource.data.petName.size() > 0 && request.resource.data.petName.size() <= 40
        && request.resource.data.species in ['dog', 'cat']
        && request.resource.data.breed is string && request.resource.data.breed.size() <= 60
        && request.resource.data.city is string && request.resource.data.city.size() <= 40
        && request.resource.data.cityKey is string && request.resource.data.cityKey.size() <= 60
        && request.resource.data.breedKey is string && request.resource.data.breedKey.size() <= 70
        && request.resource.data.seasonMiles is int && request.resource.data.seasonMiles >= 0 && request.resource.data.seasonMiles <= 100000
        && request.resource.data.level in ['bronze', 'prata', 'ouro', 'diamante']
        && request.resource.data.season == season
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string);
    }

    match /pets/{petId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.guardianIds;
      // tutores editam, mas não trocam o dono nem a lista de tutores (só o dono pode)
      allow update: if request.auth != null
        && request.auth.uid in resource.data.guardianIds
        && request.resource.data.ownerId == resource.data.ownerId
        && (request.resource.data.guardianIds == resource.data.guardianIds || request.auth.uid == resource.data.ownerId);
      // só o dono apaga o passaporte
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.guardianIds;

      // itinerário, carimbos, milhas, pesagens, diário e conversas
      match /{collection}/{docId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/pets/$(petId)).data.guardianIds;
      }
    }
  }
}
